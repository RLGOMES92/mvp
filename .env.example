# Já existente no projeto (Vercel AI Gateway) — NÃO mude o valor, só confirme que existe no painel da Vercel:
AI_GATEWAY_API_KEY=
# Opcional (padrões abaixo):
AI_MODEL=openai/gpt-5-mini

# Limites da demonstração pública (aplicados no SERVIDOR). Padrões:
ANALYZE_PER_HOUR=6            # análises de site por IP/hora
CHAT_PER_HOUR_IP=40           # mensagens ao agente por IP/hora
CHAT_PER_SESSION=25           # mensagens por IP + site analisado/hora
DEMO_DAILY_ANALYZE_LIMIT=300  # teto global de análises por dia
DEMO_DAILY_AI_LIMIT=600       # teto global de respostas de IA por dia (controla custo)
DEMO_MAX_TOKENS=500           # tamanho máximo de cada resposta
DEMO_ALLOWED_ORIGINS=         # origens extras permitidas (separe por vírgula); o próprio domínio já é permitido

# RECOMENDADO para os limites valerem entre instâncias (Upstash Redis / Vercel KV via Marketplace):
KV_REST_API_URL=
KV_REST_API_TOKEN=
