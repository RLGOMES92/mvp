# Copie para .env.local (local) ou configure em Vercel > Settings > Environment Variables.
# NUNCA faça commit de .env.local.
AI_GATEWAY_API_KEY=
# Opcional
AI_MODEL=openai/gpt-5-mini
AI_MAX_TOKENS=1000
# Origens autorizadas a chamar /api/agent (separe por vírgula). Ex.: https://seu-projeto.vercel.app
ALLOWED_ORIGINS=
